# Remote backup destination
REMOTE_HOST=odroidc5.local
REMOTE_USER=odroid
REMOTE_BASE_DIR=/home/odroid/homelab_backups

# SSH configuration
SSH_KEY=/home/odroid/.ssh/homelab_backup
SSH_PORT=22

# Local backup source
LOCAL_BACKUP_DIR=/home/odroid/backups/meal_project

# age public recipient used to encrypt sensitive-file archives.
# Keep the matching private identity separate from this machine and the remote host.
AGE_RECIPIENT=age1replace_with_your_public_recipient

# Maximum time to wait for an active Meal_Project operation
LOCK_WAIT_SECONDS=300
